# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily API key for web search fallback (https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional overrides
CRAG_MODEL_NAME=claude-sonnet-4-5
CRAG_TEMPERATURE=0
CRAG_MAX_RETRIES=3
CRAG_WEB_SEARCH_RESULTS=3
